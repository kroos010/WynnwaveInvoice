@inherits LayoutComponentBase

<div class="flex min-h-screen bg-canvas font-sans text-slate-800 antialiased">

    <NavMenu />

    <div class="flex min-w-0 flex-1 flex-col">

        <header class="sticky top-0 z-10 flex h-16 items-center gap-4 border-b border-slate-200 bg-white/80 px-5 backdrop-blur lg:px-8">
            <button class="grid h-9 w-9 place-items-center rounded-lg text-slate-500 hover:bg-slate-100 lg:hidden">
                <i class="ti ti-menu-2 text-xl"></i>
            </button>

            <div class="relative hidden w-full max-w-sm sm:block">
                <i class="ti ti-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" placeholder="Zoek factuur of klant…"
                       class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-500/25" />
            </div>

            <HeaderActions @rendermode="InteractiveServer" />
        </header>

        <main class="flex-1 px-5 py-6 lg:px-8 lg:py-8">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    Er ging iets mis.
    <a href="" class="reload">Herladen</a>
    <span class="dismiss">🗙</span>
</div>