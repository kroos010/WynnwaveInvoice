@* Facturio/Components/Layout/NavMenu.razor *@

<aside class="hidden w-64 shrink-0 flex-col bg-brand-950 text-slate-300 lg:flex">

    <div class="flex h-16 items-center gap-3 border-b border-white/5 px-6">
        <div class="grid h-9 w-9 place-items-center rounded-xl bg-accent-500 text-white">
            <i class="ti ti-receipt-2 text-xl"></i>
        </div>
        <span class="font-display text-lg font-semibold tracking-tight text-white">Facturio</span>
    </div>

    <nav class="flex-1 space-y-1 px-3 py-5">
        <p class="px-3 pb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Overzicht</p>

        <NavLink href="" Match="NavLinkMatch.All" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-layout-dashboard text-lg"></i> Dashboard
        </NavLink>
        <NavLink href="facturen" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-file-invoice text-lg"></i> Facturen
            <span class="ml-auto rounded-full bg-accent-500/15 px-2 py-0.5 text-[11px] font-semibold text-accent-300">8</span>
        </NavLink>
        <NavLink href="klanten" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-users text-lg"></i> Klanten
        </NavLink>
        <NavLink href="betalingen" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-credit-card text-lg"></i> Betalingen
        </NavLink>

        <p class="px-3 pb-2 pt-5 text-[11px] font-semibold uppercase tracking-wider text-slate-500">Beheer</p>

        <NavLink href="rapportages" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-chart-histogram text-lg"></i> Rapportages
        </NavLink>
        <NavLink href="instellingen" class="nav-link" ActiveClass="nav-link-active">
            <i class="ti ti-settings text-lg"></i> Instellingen
        </NavLink>
    </nav>

    <div class="px-3 pb-3">
        <div class="rounded-xl bg-accent-500 p-4 text-white">
            <p class="font-display text-sm font-semibold">Upgrade naar Pro</p>
            <p class="mt-1 text-xs text-accent-50/90">Onbeperkt facturen &amp; rapportages.</p>
            <button class="mt-3 w-full rounded-lg bg-white/95 py-1.5 text-xs font-semibold text-accent-700 transition hover:bg-white">Bekijk plannen</button>
        </div>
    </div>

    <div class="flex items-center gap-3 border-t border-white/5 px-5 py-4">
        <div class="grid h-9 w-9 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">TV</div>
        <div class="min-w-0">
            <p class="truncate text-sm font-medium text-white">Tom Vermeer</p>
            <p class="truncate text-xs text-slate-500">tom@studio.nl</p>
        </div>
        <i class="ti ti-dots-vertical ml-auto text-slate-500"></i>
    </div>
</aside>

@*  De classes .nav-link en .nav-link-active staan in Styles/app.css onder
    @layer components (scoped .razor.css kan geen @apply verwerken, want dat
    bestand gaat niet door Tailwind heen — alleen door Blazor's CSS-bundler). *@
