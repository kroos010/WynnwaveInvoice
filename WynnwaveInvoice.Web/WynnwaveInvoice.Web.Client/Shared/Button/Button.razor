<button @attributes="Extra" type="@Type" class="@CssClass" disabled="@(Disabled || Loading)" @onclick="OnClick">
    @if (Loading)
    {
        <i class="ti ti-loader-2 animate-spin"></i>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <i class="ti @Icon"></i>
    }
    @ChildContent
</button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Normal;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }


    public enum ButtonVariant { Primary, Secondary, Outline, Ghost, Danger }
    public enum ButtonSize { Normal, Small }

    private string CssClass
    {
        get
        {
            var variant = Variant switch
            {
                ButtonVariant.Secondary => "btn-secondary",
                ButtonVariant.Outline => "btn-outline",
                ButtonVariant.Ghost => "btn-ghost",
                ButtonVariant.Danger => "btn-danger",
                _ => "btn-primary",
            };
            var size = Size == ButtonSize.Small ? " btn-sm" : "";
            var user = Extra is not null && Extra.TryGetValue("class", out var c) ? $" {c}" : "";
            return $"btn {variant}{size}{user}";
        }
    }
}
